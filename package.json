{
  "name": "nav-router-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs"
  ],
  "scripts": {
    "docs": "npm -w docs run dev",
    "flat": "npm -w examples/flat run dev",
    "nested": "npm -w examples/nested run dev",
    "solid": "npm -w examples/solid run dev",
    "format": "npx dprint fmt",
    "setup": "npx simple-git-hooks"
  },
  "devDependencies": {
    "dprint": "^0.57.1",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bash tools/hooks/pre-commit",
    "commit-msg": "bash tools/hooks/commit-msg \"$1\""
  }
}
