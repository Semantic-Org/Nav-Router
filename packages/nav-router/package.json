{
  "name": "nav-router",
  "version": "0.1.0",
  "title": "Nav Router",
  "description": "A thin Navigation API router built on web standards",
  "author": "Jack Lukic",
  "homepage": "https://navrouter.dev",
  "license": "ISC",
  "type": "module",
  "sideEffects": false,
  "engines": {
