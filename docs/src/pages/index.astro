---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import body from '../lib/home-body.html?raw';
import { getCollection } from 'astro:content';

import { PLUGINS } from '../lib/plugins.js';
import { formatSize, sizeOf } from '../lib/sizes.js';

// the markup is the prototype's, kept as html: its code samples are full of braces astro would
// read as expressions. plugin sizes are measured from the source at build
const written = new Set((await getCollection('docs')).map((e) => e.id));
const rows = await Promise.all(PLUGINS.map(async (p) => {
  const size = formatSize(await sizeOf(p.name)) ?? '–';
  const href = written.has(`plugins/${p.name}`) ? `/plugins/${p.name}/` : '/plugins/';
  return `<a class="pt-row" href="${href}"><code>${p.name}</code><span>${p.short}</span><span class="num">${size}</span></a>`;
}));
const html = body.replace('{{plugin-rows}}', rows.join('\n        ')).replace('href="#">Browse all plugins', 'href="/plugins/">Browse all plugins');
---
<Base title="nav-router" description="Your browser’s native router made powerful. Routes, guards, data and views on the Navigation API.">
  <Fragment set:html={html} />
  <script>
    import { init } from '../scripts/site.js';
    import { mountTrace } from '../scripts/hero.js';
    init();
    mountTrace(document.querySelector('.instrument'));

    // the install chip copies whichever command is showing
    const button = document.querySelector('[data-copy-install]');
    button.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>';
    button.addEventListener('click', async () => {
      const code = document.querySelector('.install-cmd .swap code:not([hidden])');
      try { await navigator.clipboard.writeText(code.textContent); } catch {}
      button.dataset.copied = '';
      setTimeout(() => delete button.dataset.copied, 1400);
    });
  </script>
</Base>
