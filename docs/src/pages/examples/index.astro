---
// the examples landing: every example as a card, grouped as the sidebar groups them
import { getCollection } from 'astro:content';

import DocsChrome from '../../layouts/DocsChrome.astro';
import { inline } from '../../lib/markdown/inline.js';
import { SECTIONS } from '../../lib/nav.js';

const entries = new Map((await getCollection('examples')).map((e) => [`examples/${e.id}`, e]));
const groups = SECTIONS.find((s) => s.key === 'examples').groups
  .map((g) => ({ label: g.label, items: g.items.filter((it) => entries.has(it.slug)).map((it) => ({ ...it, entry: entries.get(it.slug) })) }))
  .filter((g) => g.items.length);
const lede = 'Small apps you can run and edit right here. Each one shows one thing the router does, with a few things to try in the preview.';
---
<DocsChrome title="Examples · nav-router" description={lede} currentId="examples" wide>
  <main class="doc is-wide" id="content" data-pagefind-body>
    <span hidden data-pagefind-meta="title:Examples"></span>
    <span hidden data-pagefind-meta="section:Examples"></span>
    <span hidden data-pagefind-meta="crumb:Examples"></span>
    <h1>Examples</h1>
    <p class="doc-lede">{lede}</p>

    {groups.map((g) => (
      <section class="example-group">
        <h2 class="example-group-label">{g.label}</h2>
        <ul class="example-cards" role="list">
          {g.items.map((it) => (
            <li class="example-card">
              <h3><a class="example-link" href={`/${it.slug}/`}>{it.entry.data.title}</a></h3>
              <p set:html={inline(it.entry.data.description)} />
              <p class="example-card-try"><span>Try</span> <span set:html={inline(it.entry.data.try[0])} /></p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</DocsChrome>
