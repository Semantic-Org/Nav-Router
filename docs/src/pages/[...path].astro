---
// every docs page, in every language: english at the root and each other language under its path,
// where a page it hasn't translated shows the english. the homepage, the examples and the plugins
// landing have routes of their own beside this one (pages/[...locale]/), so each kind of page ships
// its own styles and no other's
import { getCollection } from 'astro:content';

import { behind, ENABLED, localePath } from '../lib/i18n.js';
import Doc from '../views/Doc.astro';

export async function getStaticPaths() {
  // say which translations the english has moved past, where whoever changed the english will see it
  for (const { file, english, source, orphan } of await behind()) {
    console.warn(orphan
      ? `[i18n] ${file} translates a page that is gone`
      : `[i18n] ${file} is behind ${english}: bring it up to date, then set source: '${source}'`);
  }
  const entries = await getCollection('docs');
  return ENABLED.flatMap(({ code }) => entries.map((entry) => ({
    params: { path: localePath(`/${entry.id}`, code).slice(1) },
    props: { entry },
  })));
}
---
<Doc entry={Astro.props.entry} />
