---
// the docs topbar: wordmark, sections, search, framework, github, theme
import { ICON, MARK } from '../lib/icons.js';
import { languageMenu, localePath, t } from '../lib/i18n.js';
import { versionMenu } from '../lib/versions.js';

const { nav, sectionKey = null, menu = true } = Astro.props;
const code = Astro.currentLocale;
---
<header class="topbar docs-topbar">
  <div class="docs-topbar-inner">
    {menu && <button class="icon-btn nav-toggle" type="button" aria-label={t(code, 'nav.open')} aria-expanded="false" aria-controls="docs-sidebar" set:html={ICON.menu} />}
    <a class="wordmark" href={localePath('/', code)} aria-label={t(code, 'nav.home')}><Fragment set:html={MARK} />nav-router</a>
    <nav class="section-tabs" aria-label={t(code, 'nav.sections')}>
      {nav.map((s) => <a href={s.href} aria-current={s.key === sectionKey ? 'page' : undefined}>{s.label}</a>)}
    </nav>
    <div class="topbar-tools">
      <Fragment set:html={versionMenu(Astro.site, code)} />
      <Fragment set:html={languageMenu(Astro.url.pathname, code)} />
      <button class="search-trigger" type="button" aria-keyshortcuts="Meta+K Control+K"><Fragment set:html={ICON.search} /><span class="label">{t(code, 'search.label')}</span><span class="keys" aria-hidden="true"><kbd>⌘</kbd><kbd>K</kbd></span></button>
        <a class="icon-btn" href="https://github.com/" aria-label={t(code, 'nav.github')} set:html={ICON.github} />
      <button class="icon-btn" type="button" data-theme-toggle aria-label={t(code, 'nav.theme')} set:html={ICON.theme} />
    </div>
  </div>
</header>
