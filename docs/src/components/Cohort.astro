---
// the cohort: the routers people actually use, each on the browser api it's built on. they sit at
// 2010, on the History API; nav-router sits at 2026, on the Navigation API, alone. checked against each
// router's own source (November 2026): every one defaults to pushState and popstate.
// logos: Simple Icons, monochrome, for identification. sizes: min+br, each package's latest version
// bundled for its smallest working router with its framework left out (November 2026). Next.js ships
// its router inside its own runtime, so it has no size of its own to show
import { t } from '../lib/i18n.js';
import { MARK } from '../lib/icons.js';
import { formatSize, sizeOf } from '../lib/sizes.js';

const locale = Astro.currentLocale;

