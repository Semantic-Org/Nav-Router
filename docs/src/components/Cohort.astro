  { name: 'Vue Router', for: 'Vue', size: '8.9 kB', d: 'M24,1.61H14.06L12,5.16,9.94,1.61H0L12,22.39ZM12,14.08,5.16,2.23H9.59L12,6.41l2.41-4.18h4.43Z' },
];
const YEARS = [2010, 2014, 2018, 2022, 2026];
---
<section class="ribbon cohort-ribbon">
  <div class="container">
    <div class="ribbon-head">
      <h2>{t(locale, 'home.cohort.title')}</h2>
      {/* nav-router's claim, set as its tile's twin: it lights when the tile does */}
      <p class="cohort-us">
        <span class="cohort-us-mark" set:html={MARK} />
        <span>{t(locale, 'home.cohort.us')}</span>
        <a class="cohort-us-base" href="https://caniuse.com/mdn-api_navigation" target="_blank" rel="noopener" title={t(locale, 'home.cohort.baseline.title')}>{t(locale, 'home.cohort.baseline')}</a>
      </p>
      {/* the others, set as the claim's dim twin: the same shape in the old material */}
      <p class="cohort-them">
        <span set:html={t(locale, 'home.cohort.them')} />
        <span class="cohort-them-base">{t(locale, 'home.cohort.since')}</span>
      </p>
    </div>

    <figure class="cohort" data-cohort>
      <div class="cohort-stage">
        <ul class="cohort-old" aria-label={t(locale, 'home.cohort.old.label')}>
          {COHORT.map((r) => (
            <li class="cohort-tile">
              <span class="cohort-name"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={r.d} /></svg>{r.name}</span>
              <span class="cohort-meta">
                <span class="cohort-for">{t(locale, 'home.cohort.only', { framework: r.for })}</span>
                {r.size
                  ? <span class="cohort-size" title={t(locale, 'page.minBr')}>{r.size}</span>
                  : <span class="cohort-size" title={t(locale, 'home.cohort.next.title')}>{t(locale, 'home.cohort.next.size')}</span>}
              </span>
            </li>
          ))}
        </ul>
        <div class="cohort-new">
          <div class="cohort-tile is-us">
            <span class="cohort-name"><span class="cohort-mark" set:html={MARK} />nav-router</span>
            <span class="cohort-meta">
              <span class="cohort-for">{t(locale, 'home.cohort.any')}</span>
              <span class="cohort-size" title={t(locale, 'page.minBr')}>{formatSize(await sizeOf('core'))}</span>
            </span>
          </div>
        </div>
      </div>

      <div class="cohort-axis" aria-hidden="true">
        <span class="cohort-line"></span>
        {YEARS.map((y, i) => <span class:list={['cohort-year', { 'is-first': i === 0, 'is-last': i === YEARS.length - 1 }]} style={`--at: ${i / (YEARS.length - 1)}`}>{y}</span>)}
      </div>
      <div class="cohort-apis">
        <p><b>History API</b> <span>{t(locale, 'home.cohort.added')}</span></p>
        <p><b>Navigation API</b> <span>{t(locale, 'home.cohort.baseline')}</span></p>
      </div>
    </figure>
  </div>
</section>

<script>
  import { markPulse } from '../scripts/mark-pulse.js';

  // one moment: the years draw out from 2010 to 2026, then nav-router lights, the tile and the line
  // that answers the heading together, and both marks run their pulse as they do
  document.querySelectorAll('[data-cohort]').forEach((figure) => {
    const marks = [...figure.closest('section').querySelectorAll('.cohort-mark svg, .cohort-us-mark svg')].map(markPulse);
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) { return; }
      io.disconnect();
      figure.classList.add('is-drawn');
      setTimeout(() => marks.forEach((play) => play()), 1100);
    }, { threshold: 0.4 });
    io.observe(figure);
  });
</script>
