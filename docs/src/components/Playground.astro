---
// a live example: editor tabs beside a preview in a browser bar, built and served in the browser by
// the playground engine. pass the example's files ({ name: content }) and the tabs to show
const { files, tabs, label = 'Live example' } = Astro.props;
// the files ride a json script, so their braces and tags never meet astro's template
const data = JSON.stringify({ files, tabs }).replace(/</g, '\\u003c');
const editorId = `pg-editor-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="pg" data-playground aria-label={label}>
  <div class="pg-editor-pane" id={editorId}>
    <div class="code-head pg-tabs" role="tablist" aria-label="Files" data-own-tabs data-pg-tabs></div>
    <div class="pg-editor" data-pg-editor></div>
  </div>
  <div class="pg-split" role="separator" tabindex="0" aria-label="Resize editor and preview" aria-controls={editorId} title="Drag to resize · double-click to reset" data-pg-split></div>
  <div class="pg-preview-pane">
    <div class="pg-bar">
      <button class="pg-nav" type="button" data-pg-back aria-label="Back" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
      <button class="pg-nav" type="button" data-pg-forward aria-label="Forward" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
      <button class="pg-nav" type="button" data-pg-reload aria-label="Reload"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5"/></svg></button>
      <div class="pg-url"><span class="pg-host">app</span><span data-pg-path>/</span></div>
    </div>
    <div class="pg-frame" data-pg-frame></div>
    <p class="pg-status" aria-live="polite" data-pg-status>Starting…</p>
  </div>
  <script is:inline type="application/json" data-pg-files set:html={data}></script>
</div>

<script>
  import { mountPlayground } from '../scripts/playground.js';
  import { mountSplit } from '../scripts/pg-split.js';
  document.querySelectorAll('[data-playground]').forEach((root) => { mountSplit(root); mountPlayground(root); });
</script>
